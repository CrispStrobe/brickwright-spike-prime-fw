FROM ubuntu:24.04@sha256:1e0a86e57d247923571b75e0aaf48a1449cf8c543d51fb3e07a4a7d7bfa79316 AS nuttx-tools

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    bison \
    flex \
    g++ \
    gperf \
    libncurses5-dev \
    make \
    && rm -rf /var/lib/apt/lists/*

ARG NUTTX_TOOLS_COMMIT=9ad3e1ee75c7d39bfee8019ce44f4fd035d89584
ARG NUTTX_TOOLS_SHA256=7e0d477edf35b540c874e9312d0c3843440ee2d608bedeeaeda8ccdebf023d91

RUN mkdir -p /tools/nuttx-tools \
    && curl -fL --retry 3 \
       "https://github.com/patacongo/tools/archive/${NUTTX_TOOLS_COMMIT}.tar.gz" \
       -o /tmp/nuttx-tools.tar.gz \
    && echo "${NUTTX_TOOLS_SHA256}  /tmp/nuttx-tools.tar.gz" | sha256sum -c - \
    && tar -C /tools/nuttx-tools --strip-components=1 -xzf /tmp/nuttx-tools.tar.gz \
    && rm /tmp/nuttx-tools.tar.gz

RUN cd /tools/nuttx-tools/kconfig-frontends \
    && ./configure --enable-mconf --disable-gconf --disable-qconf \
       --enable-static --prefix=/tools/kconfig-frontends \
    && make install \
    && rm -rf /tools/nuttx-tools

###############################################################################
# Final image
###############################################################################
FROM ubuntu:24.04@sha256:1e0a86e57d247923571b75e0aaf48a1449cf8c543d51fb3e07a4a7d7bfa79316

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    git \
    wget \
    bison \
    flex \
    gettext \
    texinfo \
    gperf \
    xxd \
    genromfs \
    libncurses5-dev \
    libncursesw5-dev \
    python3 \
    python3-kconfiglib \
    u-boot-tools \
    util-linux \
    dfu-util \
    unzip \
    && rm -rf /var/lib/apt/lists/*

ARG ARM_TOOLCHAIN_URL=https://developer.arm.com/-/media/Files/downloads/gnu/13.2.Rel1/binrel/arm-gnu-toolchain-13.2.Rel1-x86_64-arm-none-eabi.tar.xz
ARG ARM_TOOLCHAIN_SHA256=6cd1bbc1d9ae57312bcd169ae283153a9572bd6a8e4eeae2fedfbc33b115fdbb
RUN curl -fL --retry 3 "$ARM_TOOLCHAIN_URL" -o /tmp/arm-toolchain.tar.xz \
    && echo "$ARM_TOOLCHAIN_SHA256  /tmp/arm-toolchain.tar.xz" | sha256sum -c - \
    && mkdir -p /opt/arm-toolchain \
    && tar -C /opt/arm-toolchain --strip-components=1 -xJf /tmp/arm-toolchain.tar.xz \
    && rm /tmp/arm-toolchain.tar.xz

COPY --from=nuttx-tools /tools/kconfig-frontends/ /tools/kconfig-frontends/
ENV PATH="/opt/arm-toolchain/bin:/tools/kconfig-frontends/bin:$PATH" \
    PYTHONNOUSERSITE=1

CMD [ "/bin/bash" ]
