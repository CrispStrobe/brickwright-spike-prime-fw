/****************************************************************************
 * boards/spike-prime-hub/src/etc/init.d/rcS
 *
 * NSH start-up script.  Auto-launches the btsensor and drivebase daemons at
 * console boot.
 *
 * Executed once by nsh_initscript() (idempotent via g_nsh_script_initialized)
 * after BOARDCTL_INIT and BOARDCTL_FINALINIT have completed, so all kernel
 * drivers are ready.  btnsh sessions reach NSH via nsh_session() directly
 * and never re-enter this script.
 *
 * `drivebase start` uses the default 56 mm wheel / 112 mm axle / 2 ms tick.
 * If no motors are attached it fails fast with an error line — non-fatal,
 * the daemon simply does not come up (Issue #120).
 ****************************************************************************/

#include <nuttx/config.h>

#if defined(CONFIG_APP_PORT) && defined(CONFIG_LEGO_LUMP) && \
    defined(CONFIG_BUILD_PROTECTED) && \
    defined(CONFIG_APP_BTSENSOR_SIM_NO_SERVICE_PACK)
/* One-shot read-only syscall probe; no motor control or feedback injection. */
port simulation-poll-probe
#endif

#ifdef CONFIG_APP_HUBPROGRAM
/* Local program execution must not depend on radio startup. */
hubprogram serve
#endif

#if defined(CONFIG_APP_BTSENSOR) && \
    (!defined(CONFIG_APP_BTSENSOR_SIM_NO_SERVICE_PACK) || \
     defined(CONFIG_APP_BTSENSOR_SIM_VIRTUAL_HCI))
/* A TI-free simulation has no controller unless explicitly configured. */
btsensor start
#endif

#if defined(CONFIG_APP_DRIVEBASE) && !defined(CONFIG_APP_HUBPROGRAM)
/* Autonomous programs acquire their own ports; do not pre-claim A/B. */
drivebase start
#endif
