diff --git a/nshlib/nsh_console.c b/nshlib/nsh_console.c
index cb95e0342..1522589e3 100644
--- a/nshlib/nsh_console.c
+++ b/nshlib/nsh_console.c
@@ -20,6 +20,12 @@
  *
  ****************************************************************************/
 
+/* Modified for Brickwright in 2026: reviewed Apache NuttX backports and
+ * local integration/adaptations. Original copyright and licence notices
+ * retained. Source commits and scope: policy/nuttx-backports.json in the
+ * Brickwright firmware repository.
